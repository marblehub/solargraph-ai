@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix pmd: <https://w3id.org/pmd/co/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix pv: <https://w3id.org/pvsolar#> .

<https://w3id.org/pvsolar> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/pvsolar/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    dcterms:title "PV Solar and Materials Science Engineering Ontology"@en ;
    dcterms:description "A PMDco-aligned ontology for photovoltaic materials, devices, processes, characterisation, defects, performance, degradation, tests, institutions, and researchers."@en ;
    dcterms:creator <https://orcid.org/0000-0002-5152-095X> ;
    dcterms:created "2026-09-23"^^xsd:date ;
    dcterms:modified "2026-09-23"^^xsd:date ;
    dcterms:license <https://opensource.org/license/mit/> ;
    owl:imports <https://w3id.org/pmd/co/3.1.1>,
                <http://qudt.org/schema/qudt>,
                <http://qudt.org/vocab/quantitykind>,
                <http://qudt.org/vocab/unit>,
                <http://www.w3.org/ns/prov-o#> .

# ═══════════════════════════════════════════════════════════════════════════════
#  TERMINOLOGICAL BOX (TBOX)
# ═══════════════════════════════════════════════════════════════════════════════

pv:Material a owl:Class ;
    rdfs:subClassOf pmd:PMD_0000000 ;
    rdfs:label "Material"@en ;
    skos:prefLabel "Material"@en ;
    rdfs:comment "Any solid-state or thin-film material relevant to PV devices." .

pv:Semiconductor a owl:Class ;
    rdfs:subClassOf pv:Material ;
    rdfs:label "Semiconductor"@en ;
    skos:prefLabel "Semiconductor"@en ;
    rdfs:comment "Material with a bandgap suitable for solar energy conversion." .

pv:Absorber a owl:Class ;
    rdfs:subClassOf pv:Semiconductor ;
    rdfs:label "Absorber Layer"@en ;
    skos:prefLabel "Absorber Layer"@en ;
    rdfs:comment "Light-absorbing semiconductor layer in a PV cell." .

pv:TransportLayer a owl:Class ;
    rdfs:subClassOf pv:Material ;
    rdfs:label "Charge Transport Layer"@en ;
    skos:prefLabel "Charge Transport Layer"@en ;
    rdfs:comment "Electron or hole transport layer in a PV device stack." .

pv:Electrode a owl:Class ;
    rdfs:subClassOf pv:Material ;
    rdfs:label "Electrode"@en ;
    skos:prefLabel "Electrode"@en ;
    rdfs:comment "Front or back contact electrode material." .

pv:Encapsulant a owl:Class ;
    rdfs:subClassOf pv:Material ;
    rdfs:label "Encapsulant"@en ;
    skos:prefLabel "Encapsulant"@en ;
    rdfs:comment "Polymer or glass used to protect PV cells from environmental stress." .

pv:CellArchitecture a owl:Class ;
    rdfs:subClassOf pmd:PMD_0060006 ;
    rdfs:label "Cell Architecture"@en ;
    skos:prefLabel "Cell Architecture"@en ;
    rdfs:comment "A specific PV device stack configuration (e.g., p-i-n, n-i-p, tandem)." .

pv:FabricationProcess a owl:Class ;
    rdfs:subClassOf pmd:PMD_0000833 ;
    rdfs:label "Fabrication Process"@en ;
    skos:prefLabel "Fabrication Process"@en ;
    rdfs:comment "A deposition or processing method used in PV manufacturing." .

pv:CharacterisationTechnique a owl:Class ;
    rdfs:subClassOf obo:OBI_0000070 ;
    rdfs:label "Characterisation Technique"@en ;
    skos:prefLabel "Characterisation Technique"@en ;
    skos:altLabel "Characterization Technique"@en ;  # US spelling
    skos:altLabel "Characterisation Method"@en ;
    rdfs:comment "Experimental method for measuring material or device properties." .

pv:Defect a owl:Class ;
    rdfs:label "Defect"@en ;
    skos:prefLabel "Defect"@en ;
    rdfs:comment "Structural or electronic defect in a PV material that reduces performance." .

pv:PerformanceMetric a owl:Class ;
    rdfs:subClassOf pmd:PMD_0020335, qudt:QuantityKind ;
    rdfs:label "Performance Metric"@en ;
    skos:prefLabel "Performance Metric"@en ;
    rdfs:comment "A measurable figure of merit for a PV material or device." .

pv:DegradationMechanism a owl:Class ;
    rdfs:subClassOf obo:BFO_0000015 ;
    rdfs:label "Degradation Mechanism"@en ;
    skos:prefLabel "Degradation Mechanism"@en ;
    rdfs:comment "Physical or chemical mechanism causing PV performance loss over time." .

pv:Institution a owl:Class ;
    rdfs:subClassOf obo:OBI_0000245 ;
    rdfs:label "Institution"@en ;
    skos:prefLabel "Institution"@en ;
    rdfs:comment "University, national laboratory, or company active in PV research or manufacturing." .

pv:Researcher a owl:Class ;
    rdfs:subClassOf prov:Person ;
    rdfs:label "Researcher"@en ;
    skos:prefLabel "Researcher"@en ;
    rdfs:comment "A scientist or engineer contributing to PV or materials science research." .

pv:StandardTest a owl:Class ;
    rdfs:subClassOf obo:OBI_0000070 ;
    rdfs:label "Standard Test Condition"@en ;
    skos:prefLabel "Standard Test Condition"@en ;
    rdfs:comment "Defined conditions under which PV performance is officially measured." .

# ═══════════════════════════════════════════════════════════════════════════════
#  DISJOINTNESS AXIOMS
# ═══════════════════════════════════════════════════════════════════════════════

pv:Material owl:disjointWith
    pv:CellArchitecture,
    pv:FabricationProcess,
    pv:CharacterisationTechnique,
    pv:PerformanceMetric,
    pv:DegradationMechanism,
    pv:Institution,
    pv:Researcher,
    pv:StandardTest .

pv:FabricationProcess owl:disjointWith pv:CharacterisationTechnique, pv:StandardTest .
pv:Institution owl:disjointWith pv:Researcher .
pv:CharacterisationTechnique owl:disjointWith pv:StandardTest .

# ═══════════════════════════════════════════════════════════════════════════════
#  OBJECT PROPERTIES
# ═══════════════════════════════════════════════════════════════════════════════

pv:usedIn a owl:ObjectProperty ;
    rdfs:label "used in"@en ;
    skos:prefLabel "used in"@en ;
    rdfs:domain pv:Material ;
    rdfs:range  pv:CellArchitecture .

pv:fabricatedBy a owl:ObjectProperty ;
    rdfs:label "fabricated by"@en ;
    skos:prefLabel "fabricated by"@en ;
    rdfs:domain pv:Material ;
    rdfs:range  pv:FabricationProcess .

pv:characterisedBy a owl:ObjectProperty ;
    rdfs:label "characterised by"@en ;
    skos:prefLabel "characterised by"@en ;
    rdfs:domain pv:Material ;
    rdfs:range  pv:CharacterisationTechnique .

pv:hasDefect a owl:ObjectProperty ;
    rdfs:label "has defect"@en ;
    skos:prefLabel "has defect"@en ;
    rdfs:domain pv:Semiconductor ;
    rdfs:range  pv:Defect .

pv:measuredBy a owl:ObjectProperty ;
    rdfs:label "measured by"@en ;
    skos:prefLabel "measured by"@en ;
    rdfs:domain pv:PerformanceMetric ;
    rdfs:range  pv:CharacterisationTechnique .

pv:affectsMetric a owl:ObjectProperty ;
    rdfs:label "affects metric"@en ;
    skos:prefLabel "affects metric"@en ;
    rdfs:domain pv:Defect ;
    rdfs:range  pv:PerformanceMetric .

pv:causedBy a owl:ObjectProperty ;
    rdfs:label "caused by"@en ;
    skos:prefLabel "caused by"@en ;
    rdfs:domain pv:DegradationMechanism ;
    rdfs:range  pv:Defect .

pv:studiedAt a owl:ObjectProperty ;
    rdfs:label "studied at"@en ;
    skos:prefLabel "studied at"@en ;
    rdfs:domain pv:Researcher ;
    rdfs:range  pv:Institution .

pv:researches a owl:ObjectProperty ;
    rdfs:label "researches"@en ;
    skos:prefLabel "researches"@en ;
    rdfs:domain pv:Researcher ;
    rdfs:range  pv:Material .

pv:developedBy a owl:ObjectProperty ;
    rdfs:label "developed by"@en ;
    skos:prefLabel "developed by"@en ;
    rdfs:domain pv:CellArchitecture ;
    rdfs:range  pv:Institution .

pv:mitigatedBy a owl:ObjectProperty ;
    rdfs:label "mitigated by"@en ;
    skos:prefLabel "mitigated by"@en ;
    rdfs:domain pv:Defect ;
    rdfs:range  pv:FabricationProcess .

pv:compatibleWith a owl:ObjectProperty ;
    rdfs:label "compatible with"@en ;
    skos:prefLabel "compatible with"@en ;
    rdfs:domain pv:Material ;
    rdfs:range  pv:Material .

pv:hasReportedValue a owl:ObjectProperty ;
    rdfs:label "has reported value"@en ;
    skos:prefLabel "has reported value"@en ;
    rdfs:domain pv:PerformanceMetric ;
    rdfs:range qudt:QuantityValue .

# ═══════════════════════════════════════════════════════════════════════════════
#  DATA PROPERTIES
# ═══════════════════════════════════════════════════════════════════════════════

pv:bandgap a owl:DatatypeProperty ;
    rdfs:label "bandgap"@en ;
    skos:prefLabel "bandgap"@en ;
    rdfs:domain pv:Semiconductor ;
    rdfs:range  xsd:decimal ;
    qudt:hasQuantityKind quantitykind:EnergyLevel ;
    qudt:hasUnit unit:EV .

pv:recordEfficiency a owl:DatatypeProperty ;
    rdfs:label "record efficiency"@en ;
    skos:prefLabel "record efficiency"@en ;
    rdfs:domain pv:CellArchitecture ;
    rdfs:range  xsd:decimal ;
    qudt:hasQuantityKind quantitykind:DimensionlessRatio ;
    qudt:hasUnit unit:PERCENT .

pv:crystalStructure a owl:DatatypeProperty ;
    rdfs:label "crystal structure"@en ;
    skos:prefLabel "crystal structure"@en ;
    rdfs:range xsd:string .

pv:depositionTemperature a owl:DatatypeProperty ;
    rdfs:label "deposition temperature"@en ;
    skos:prefLabel "deposition temperature"@en ;
    rdfs:domain pv:FabricationProcess ;
    rdfs:range  xsd:decimal ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:hasUnit unit:DEG_C .

pv:typicalRange a owl:DatatypeProperty ;
    rdfs:label "typical range"@en ;
    skos:prefLabel "typical range"@en ;
    rdfs:domain pv:PerformanceMetric ;
    rdfs:range  xsd:string .

pv:irradiance a owl:DatatypeProperty ;
    rdfs:label "irradiance"@en ;
    skos:prefLabel "irradiance"@en ;
    rdfs:range xsd:decimal ;
    qudt:hasQuantityKind quantitykind:PowerPerArea ;
    qudt:hasUnit unit:W-PER-M2 .

pv:cellTemperature a owl:DatatypeProperty ;
    rdfs:label "cell temperature"@en ;
    skos:prefLabel "cell temperature"@en ;
    rdfs:range xsd:decimal ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:hasUnit unit:DEG_C .

pv:testTemperature a owl:DatatypeProperty ;
    rdfs:label "test temperature"@en ;
    skos:prefLabel "test temperature"@en ;
    rdfs:range xsd:decimal ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:hasUnit unit:DEG_C .

pv:onsetTemperature a owl:DatatypeProperty ;
    rdfs:label "onset temperature"@en ;
    skos:prefLabel "onset temperature"@en ;
    rdfs:range xsd:decimal ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:hasUnit unit:DEG_C .

pv:ambientTemperature a owl:DatatypeProperty ;
    rdfs:label "ambient temperature"@en ;
    skos:prefLabel "ambient temperature"@en ;
    rdfs:range xsd:decimal ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:hasUnit unit:DEG_C .

pv:windSpeed a owl:DatatypeProperty ;
    rdfs:label "wind speed"@en ;
    skos:prefLabel "wind speed"@en ;
    rdfs:range xsd:decimal ;
    qudt:hasQuantityKind quantitykind:Speed ;
    qudt:hasUnit unit:M-PER-SEC .

pv:relativeHumidity a owl:DatatypeProperty ;
    rdfs:label "relative humidity"@en ;
    skos:prefLabel "relative humidity"@en ;
    rdfs:range xsd:decimal ;
    qudt:hasQuantityKind quantitykind:RelativeHumidity ;
    qudt:hasUnit unit:PERCENT .

pv:duration a owl:DatatypeProperty ;
    rdfs:label "duration"@en ;
    skos:prefLabel "duration"@en ;
    rdfs:range xsd:decimal ;
    qudt:hasQuantityKind quantitykind:Time ;
    qudt:hasUnit unit:HR .

pv:minimumTemperature a owl:DatatypeProperty ;
    rdfs:label "minimum temperature"@en ;
    skos:prefLabel "minimum temperature"@en ;
    rdfs:range xsd:decimal ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:hasUnit unit:DEG_C .

pv:maximumTemperature a owl:DatatypeProperty ;
    rdfs:label "maximum temperature"@en ;
    skos:prefLabel "maximum temperature"@en ;
    rdfs:range xsd:decimal ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:hasUnit unit:DEG_C .

pv:cycleCount a owl:DatatypeProperty ;
    rdfs:label "cycle count"@en ;
    skos:prefLabel "cycle count"@en ;
    rdfs:range xsd:integer ;
    qudt:hasQuantityKind quantitykind:Count ;
    qudt:hasUnit unit:NUM .

pv:country a owl:DatatypeProperty ;
    rdfs:label "country"@en ;
    skos:prefLabel "country"@en ;
    rdfs:domain pv:Institution ;
    rdfs:range  xsd:string .

pv:founded a owl:DatatypeProperty ;
    rdfs:label "founded"@en ;
    skos:prefLabel "founded"@en ;
    rdfs:domain pv:Institution ;
    rdfs:range  xsd:gYear .
