# ═══════════════════════════════════════════════════════════════════════════════
#  ABSORBER MATERIALS
# ═══════════════════════════════════════════════════════════════════════════════

pv:MonocrystallineSilicon a pv:Absorber ;
    rdfs:label "Monocrystalline Silicon (c-Si)"@en ;
    skos:prefLabel "Monocrystalline Silicon (c-Si)"@en ;
    dcterms:description "Single-crystal silicon; the dominant commercial PV absorber with high efficiency and long operational lifetime exceeding 30 years." ;
    pv:bandgap "1.12"^^xsd:decimal ;
    pv:crystalStructure "Diamond cubic" ;
    pv:usedIn pv:SHJ_Cell, pv:PERC_Cell, pv:TOPCon_Cell, pv:TandemSiliconPerovskite ;
    pv:characterisedBy pv:TRPL, pv:EQE, pv:EL ;
    pv:fabricatedBy pv:Czochralski, pv:PECVD .

pv:PolycrystallineSilicon a pv:Absorber ;
    rdfs:label "Polycrystalline Silicon (mc-Si)"@en ;
    skos:prefLabel "Polycrystalline Silicon (mc-Si)"@en ;
    dcterms:description "Multi-grain silicon wafer; lower cost than monocrystalline but reduced efficiency due to grain-boundary recombination." ;
    pv:bandgap "1.12"^^xsd:decimal ;
    pv:crystalStructure "Polycrystalline" ;
    pv:usedIn pv:PERC_Cell ;
    pv:hasDefect pv:GrainBoundaryTrap .

pv:MAPbI3 a pv:Absorber ;
    rdfs:label "Methylammonium Lead Iodide (MAPbI3)"@en ;
    skos:prefLabel "Methylammonium Lead Iodide (MAPbI3)"@en ;
    dcterms:description "Prototypical halide perovskite absorber with tuneable bandgap, high absorption coefficient, and defect tolerance — but prone to moisture and heat degradation." ;
    pv:bandgap "1.55"^^xsd:decimal ;
    pv:crystalStructure "Cubic ABX3 perovskite" ;
    pv:usedIn pv:NIP_Perovskite, pv:PIN_Perovskite ;
    pv:hasDefect pv:IodideVacancy, pv:GrainBoundaryTrap ;
    pv:characterisedBy pv:XRD, pv:PL, pv:TRPL, pv:SEM ;
    pv:fabricatedBy pv:SpinCoating, pv:SlotDieCoating, pv:SprayCoating .

pv:FAPbI3 a pv:Absorber ;
    rdfs:label "Formamidinium Lead Iodide (FAPbI3)"@en ;
    skos:prefLabel "Formamidinium Lead Iodide (FAPbI3)"@en ;
    dcterms:description "More thermally stable perovskite absorber than MAPbI3; the alpha-phase is required for efficient photovoltaics and can revert to inactive delta-phase." ;
    pv:bandgap "1.48"^^xsd:decimal ;
    pv:crystalStructure "Pseudo-cubic perovskite (alpha-phase)" ;
    pv:usedIn pv:NIP_Perovskite, pv:PIN_Perovskite ;
    pv:hasDefect pv:PhaseSeparation, pv:IodideVacancy ;
    pv:characterisedBy pv:XRD, pv:PL, pv:TRPL ;
    pv:fabricatedBy pv:SpinCoating, pv:SlotDieCoating .

pv:CIGSSe a pv:Absorber ;
    rdfs:label "CIGS (Cu(In,Ga)Se2)"@en ;
    skos:prefLabel "CIGS (Cu(In,Ga)Se2)"@en ;
    dcterms:description "Chalcopyrite thin-film absorber with tuneable bandgap by varying In/Ga ratio. Excellent radiation hardness for space applications." ;
    pv:bandgap "1.15"^^xsd:decimal ;
    pv:crystalStructure "Chalcopyrite" ;
    pv:usedIn pv:CIGS_Cell ;
    pv:hasDefect pv:CuVacancy, pv:InterfaceRecombination ;
    pv:characterisedBy pv:XRD, pv:SEM, pv:EQE ;
    pv:fabricatedBy pv:CoEvaporation .

pv:CdTe a pv:Absorber ;
    rdfs:label "Cadmium Telluride (CdTe)"@en ;
    skos:prefLabel "Cadmium Telluride (CdTe)"@en ;
    dcterms:description "Binary compound thin-film absorber with high absorption coefficient and near-ideal bandgap. Concerns exist around Cd toxicity." ;
    pv:bandgap "1.44"^^xsd:decimal ;
    pv:crystalStructure "Zinc blende" ;
    pv:usedIn pv:CdTe_Cell ;
    pv:hasDefect pv:CdVacancy, pv:InterfaceRecombination ;
    pv:characterisedBy pv:XRD, pv:TEM, pv:DLTS .

pv:GaAs a pv:Absorber ;
    rdfs:label "Gallium Arsenide (GaAs)"@en ;
    skos:prefLabel "Gallium Arsenide (GaAs)"@en ;
    dcterms:description "III-V direct-bandgap semiconductor with highest single-junction efficiency; used in concentrator PV and space applications." ;
    pv:bandgap "1.42"^^xsd:decimal ;
    pv:crystalStructure "Zinc blende" ;
    pv:usedIn pv:ConcentratorPV, pv:MultiJunction_Cell .

pv:OrganicBHJ a pv:Absorber ;
    rdfs:label "Organic Bulk Heterojunction (BHJ)"@en ;
    skos:prefLabel "Organic Bulk Heterojunction (BHJ)"@en ;
    dcterms:description "Blend of electron donor and acceptor organic semiconductors enabling flexible, low-cost PV with moderate efficiency." ;
    pv:bandgap "1.60"^^xsd:decimal ;
    pv:crystalStructure "Amorphous/semi-crystalline" ;
    pv:usedIn pv:OPV_Cell .

# ═══════════════════════════════════════════════════════════════════════════════
#  TRANSPORT LAYERS & ELECTRODES
# ═══════════════════════════════════════════════════════════════════════════════

pv:SpiroOMeTAD a pv:TransportLayer ;
    rdfs:label "Spiro-OMeTAD"@en ;
    skos:prefLabel "Spiro-OMeTAD"@en ;
    dcterms:description "Most widely used hole transport material in n-i-p perovskite cells; requires dopants (LiTFSI, FK209) for adequate conductivity." ;
    pv:usedIn pv:NIP_Perovskite ;
    pv:compatibleWith pv:MAPbI3, pv:FAPbI3 .

pv:PTAA a pv:TransportLayer ;
    rdfs:label "PTAA (Polymeric Hole Transport Layer)"@en ;
    skos:prefLabel "PTAA (Polymeric Hole Transport Layer)"@en ;
    dcterms:description "Polymeric hole transport layer used in high-efficiency inverted (p-i-n) perovskite cells; better stability than Spiro-OMeTAD." ;
    pv:usedIn pv:PIN_Perovskite ;
    pv:compatibleWith pv:MAPbI3, pv:FAPbI3 .

pv:TiO2 a pv:TransportLayer ;
    rdfs:label "Titanium Dioxide (TiO2)"@en ;
    skos:prefLabel "Titanium Dioxide (TiO2)"@en ;
    dcterms:description "Electron transport layer in n-i-p perovskite and dye-sensitised solar cells; compact and mesoporous forms are both used." ;
    pv:usedIn pv:NIP_Perovskite ;
    pv:fabricatedBy pv:SpinCoating, pv:SprayPyrolysis ;
    pv:compatibleWith pv:MAPbI3 .

pv:SnO2 a pv:TransportLayer ;
    rdfs:label "Tin Oxide (SnO2)"@en ;
    skos:prefLabel "Tin Oxide (SnO2)"@en ;
    dcterms:description "Low-temperature processable electron transport layer with better UV stability than TiO2; dominant in high-efficiency perovskite cells." ;
    pv:usedIn pv:PIN_Perovskite, pv:NIP_Perovskite ;
    pv:fabricatedBy pv:ChemicalBathDeposition, pv:SpinCoating ;
    pv:compatibleWith pv:MAPbI3, pv:FAPbI3 .

pv:C60 a pv:TransportLayer ;
    rdfs:label "Fullerene C60"@en ;
    skos:prefLabel "Fullerene C60"@en ;
    dcterms:description "Electron acceptor and ETL in inverted perovskite and organic PV cells; excellent electron mobility and energy alignment." ;
    pv:usedIn pv:PIN_Perovskite, pv:OPV_Cell ;
    pv:compatibleWith pv:MAPbI3 .

pv:ITO a pv:Electrode ;
    rdfs:label "Indium Tin Oxide (ITO)"@en ;
    skos:prefLabel "Indium Tin Oxide (ITO)"@en ;
    dcterms:description "Standard transparent front electrode for thin-film and perovskite solar cells with high transparency and conductivity." ;
    pv:usedIn pv:PIN_Perovskite, pv:NIP_Perovskite, pv:CIGS_Cell, pv:OPV_Cell ;
    pv:fabricatedBy pv:Sputtering .

pv:AluminiumBack a pv:Electrode ;
    rdfs:label "Aluminium Back Contact"@en ;
    skos:prefLabel "Aluminium Back Contact"@en ;
    dcterms:description "Evaporated aluminium rear electrode standard in silicon PERC and CIGS thin-film cells." ;
    pv:usedIn pv:PERC_Cell, pv:CIGS_Cell .

pv:EVA a pv:Encapsulant ;
    rdfs:label "Ethylene-Vinyl Acetate (EVA)"@en ;
    skos:prefLabel "Ethylene-Vinyl Acetate (EVA)"@en ;
    dcterms:description "Standard encapsulant polymer for crystalline Si modules; provides mechanical protection and acts as a moisture barrier." .

pv:POE a pv:Encapsulant ;
    rdfs:label "Polyolefin Elastomer (POE)"@en ;
    skos:prefLabel "Polyolefin Elastomer (POE)"@en ;
    dcterms:description "Low moisture permeability encapsulant preferred for bifacial and perovskite modules due to superior hydrophobicity." .

# ═══════════════════════════════════════════════════════════════════════════════
#  CELL ARCHITECTURES
# ═══════════════════════════════════════════════════════════════════════════════

pv:PERC_Cell a pv:CellArchitecture ;
    rdfs:label "PERC (Passivated Emitter and Rear Cell)"@en ;
    skos:prefLabel "PERC (Passivated Emitter and Rear Cell)"@en ;
    dcterms:description "Silicon cell with rear Al2O3/SiNx passivation layer to reduce back-surface recombination. Currently the dominant commercial architecture." ;
    pv:recordEfficiency "24.5"^^xsd:decimal ;
    pv:developedBy pv:LONGi .

pv:TOPCon_Cell a pv:CellArchitecture ;
    rdfs:label "TOPCon (Tunnel Oxide Passivated Contact)"@en ;
    skos:prefLabel "TOPCon (Tunnel Oxide Passivated Contact)"@en ;
    dcterms:description "Silicon cell with ultra-thin tunnel SiO2 and doped poly-Si passivating contact layer; achieves very high Voc." ;
    pv:recordEfficiency "26.1"^^xsd:decimal ;
    pv:developedBy pv:LONGi .

pv:SHJ_Cell a pv:CellArchitecture ;
    rdfs:label "SHJ (Silicon Heterojunction)"@en ;
    skos:prefLabel "SHJ (Silicon Heterojunction)"@en ;
    dcterms:description "Combines crystalline silicon with amorphous silicon (a-Si:H) intrinsic passivation layers; excellent Voc, bifaciality, and low temperature coefficient." ;
    pv:recordEfficiency "26.8"^^xsd:decimal ;
    pv:developedBy pv:Fraunhofer_ISE .

pv:NIP_Perovskite a pv:CellArchitecture ;
    rdfs:label "n-i-p Perovskite Solar Cell"@en ;
    skos:prefLabel "n-i-p Perovskite Solar Cell"@en ;
    dcterms:description "Standard perovskite stack: ETL (TiO2 or SnO2) on bottom, perovskite absorber in middle, HTL (Spiro-OMeTAD) on top." ;
    pv:recordEfficiency "26.1"^^xsd:decimal .

pv:PIN_Perovskite a pv:CellArchitecture ;
    rdfs:label "p-i-n Inverted Perovskite Solar Cell"@en ;
    skos:prefLabel "p-i-n Inverted Perovskite Solar Cell"@en ;
    dcterms:description "Inverted perovskite stack with HTL (PTAA/NiOx) at the bottom; better operational stability and compatible with tandem integration." ;
    pv:recordEfficiency "25.1"^^xsd:decimal .

pv:TandemSiliconPerovskite a pv:CellArchitecture ;
    rdfs:label "Perovskite/Silicon Tandem Cell"@en ;
    skos:prefLabel "Perovskite/Silicon Tandem Cell"@en ;
    dcterms:description "Two-junction monolithic device combining perovskite top cell (~1.65 eV) with silicon bottom cell (~1.12 eV); exceeds single-junction Shockley-Queisser limit." ;
    pv:recordEfficiency "33.9"^^xsd:decimal ;
    pv:developedBy pv:KAUST, pv:HZB .

pv:MultiJunction_Cell a pv:CellArchitecture ;
    rdfs:label "Multi-Junction III-V Cell"@en ;
    skos:prefLabel "Multi-Junction III-V Cell"@en ;
    dcterms:description "Three or more junctions (e.g., InGaP/GaAs/Ge) each tuned to different spectral regions; highest terrestrial efficiency under concentration." ;
    pv:recordEfficiency "47.6"^^xsd:decimal ;
    pv:developedBy pv:NREL .

pv:CIGS_Cell a pv:CellArchitecture ;
    rdfs:label "CIGS Thin-Film Cell"@en ;
    skos:prefLabel "CIGS Thin-Film Cell"@en ;
    dcterms:description "Chalcopyrite thin-film stack on glass or flexible substrate; low material usage and excellent low-light performance." ;
    pv:recordEfficiency "23.4"^^xsd:decimal .

pv:CdTe_Cell a pv:CellArchitecture ;
    rdfs:label "CdTe Thin-Film Cell"@en ;
    skos:prefLabel "CdTe Thin-Film Cell"@en ;
    dcterms:description "Cadmium telluride thin-film on glass; second largest commercial thin-film technology, dominated by First Solar." ;
    pv:recordEfficiency "22.3"^^xsd:decimal ;
    pv:developedBy pv:FirstSolar .

pv:OPV_Cell a pv:CellArchitecture ;
    rdfs:label "Organic PV (OPV) Cell"@en ;
    skos:prefLabel "Organic PV (OPV) Cell"@en ;
    dcterms:description "Carbon-based bulk heterojunction organic absorber enabling semi-transparent, flexible, roll-to-roll processable modules." ;
    pv:recordEfficiency "19.2"^^xsd:decimal .

pv:ConcentratorPV a pv:CellArchitecture ;
    rdfs:label "Concentrator PV (CPV)"@en ;
    skos:prefLabel "Concentrator PV (CPV)"@en ;
    dcterms:description "Uses optical lenses or mirrors to concentrate sunlight 500-1000x onto high-efficiency III-V cells; requires two-axis tracking." ;
    pv:recordEfficiency "47.6"^^xsd:decimal ;
    pv:developedBy pv:NREL .

pv:DSC_Cell a pv:CellArchitecture ;
    rdfs:label "Dye-Sensitised Solar Cell (DSSC)"@en ;
    skos:prefLabel "Dye-Sensitised Solar Cell (DSSC)"@en ;
    dcterms:description "Dye-sensitised mesoporous TiO2 photoanode with liquid or gel electrolyte; suited for indoor and building-integrated applications." ;
    pv:recordEfficiency "14.3"^^xsd:decimal ;
    pv:developedBy pv:EPFL .

# ═══════════════════════════════════════════════════════════════════════════════
#  FABRICATION PROCESSES
# ═══════════════════════════════════════════════════════════════════════════════

pv:SpinCoating a pv:FabricationProcess ;
    rdfs:label "Spin Coating"@en ;
    skos:prefLabel "Spin Coating"@en ;
    dcterms:description "Solution-based deposition by spinning substrate at high speed; standard laboratory method for perovskite absorbers and transport layers." ;
    pv:depositionTemperature "100"^^xsd:decimal .

pv:SprayCoating a pv:FabricationProcess ;
    rdfs:label "Spray Coating"@en ;
    skos:prefLabel "Spray Coating"@en ;
    dcterms:description "Scalable deposition by atomising precursor solution onto a substrate; suited for large-area PV manufacturing." .

pv:SlotDieCoating a pv:FabricationProcess ;
    rdfs:label "Slot-Die Coating"@en ;
    skos:prefLabel "Slot-Die Coating"@en ;
    dcterms:description "Meniscus-guided continuous coating method for roll-to-roll deposition of perovskite and organic layers at scale." .

pv:CVD a pv:FabricationProcess ;
    rdfs:label "Chemical Vapour Deposition (CVD)"@en ;
    skos:prefLabel "Chemical Vapour Deposition (CVD)"@en ;
    dcterms:description "Gas-phase precursor decomposition to deposit thin films; used for SiNx passivation and poly-Si contacts in silicon PV." ;
    pv:depositionTemperature "400"^^xsd:decimal .

pv:PECVD a pv:FabricationProcess ;
    rdfs:label "Plasma-Enhanced CVD (PECVD)"@en ;
    skos:prefLabel "Plasma-Enhanced CVD (PECVD)"@en ;
    dcterms:description "CVD assisted by plasma enabling low-temperature deposition of a-Si:H passivation layers for silicon heterojunction cells." ;
    pv:depositionTemperature "200"^^xsd:decimal .

pv:Sputtering a pv:FabricationProcess ;
    rdfs:label "Magnetron Sputtering"@en ;
    skos:prefLabel "Magnetron Sputtering"@en ;
    dcterms:description "Physical vapour deposition by energetic ion bombardment; used for ITO, ZnO, and metal back contacts." .

pv:CoEvaporation a pv:FabricationProcess ;
    rdfs:label "Co-Evaporation"@en ;
    skos:prefLabel "Co-Evaporation"@en ;
    dcterms:description "Simultaneous thermal evaporation of Cu, In, Ga sources in a selenium atmosphere to form high-quality CIGS absorber layers." ;
    pv:depositionTemperature "550"^^xsd:decimal .

pv:ChemicalBathDeposition a pv:FabricationProcess ;
    rdfs:label "Chemical Bath Deposition (CBD)"@en ;
    skos:prefLabel "Chemical Bath Deposition (CBD)"@en ;
    dcterms:description "Wet-chemical growth of CdS, ZnS, or SnO2 buffer layers from aqueous solution at low temperature." ;
    pv:depositionTemperature "60"^^xsd:decimal .

pv:SprayPyrolysis a pv:FabricationProcess ;
    rdfs:label "Spray Pyrolysis"@en ;
    skos:prefLabel "Spray Pyrolysis"@en ;
    dcterms:description "Aerosol of precursor solution thermally decomposed on a heated substrate; used to form compact TiO2 and FTO layers." ;
    pv:depositionTemperature "450"^^xsd:decimal .

pv:Czochralski a pv:FabricationProcess ;
    rdfs:label "Czochralski Process"@en ;
    skos:prefLabel "Czochralski Process"@en ;
    dcterms:description "Crystal growth technique for pulling a monocrystalline silicon ingot from a melt; primary method for high-purity c-Si wafer production." ;
    pv:depositionTemperature "1420"^^xsd:decimal .

pv:LaserScribing a pv:FabricationProcess ;
    rdfs:label "Laser Scribing"@en ;
    skos:prefLabel "Laser Scribing"@en ;
    dcterms:description "Patterning of thin-film modules by laser ablation to create P1, P2, P3 scribe lines for monolithic series interconnection." .

pv:ThermalAnnealing a pv:FabricationProcess ;
    rdfs:label "Thermal Annealing"@en ;
    skos:prefLabel "Thermal Annealing"@en ;
    dcterms:description "Post-deposition heat treatment to crystallise perovskite, evaporate residual solvents, and passivate grain boundary defects." ;
    pv:depositionTemperature "150"^^xsd:decimal .

# ═══════════════════════════════════════════════════════════════════════════════
#  CHARACTERISATION TECHNIQUES
# ═══════════════════════════════════════════════════════════════════════════════

pv:JVCurve a pv:CharacterisationTechnique ;
    rdfs:label "Current-Voltage (J-V) Characterisation"@en ;
    skos:prefLabel "Current-Voltage (J-V) Characterisation"@en ;
    dcterms:description "Primary device measurement yielding PCE, Voc, Jsc, and FF under standard AM1.5G illumination at 1000 W/m²." ;
    pv:irradiance "1000"^^xsd:decimal .

pv:EQE a pv:CharacterisationTechnique ;
    rdfs:label "External Quantum Efficiency (EQE)"@en ;
    skos:prefLabel "External Quantum Efficiency (EQE)"@en ;
    dcterms:description "Wavelength-resolved ratio of collected electrons to incident photons; reveals spectral response and optical loss mechanisms." .

pv:PL a pv:CharacterisationTechnique ;
    rdfs:label "Photoluminescence (PL) Spectroscopy"@en ;
    skos:prefLabel "Photoluminescence (PL) Spectroscopy"@en ;
    dcterms:description "Optical emission spectroscopy after photoexcitation; assesses radiative recombination quality and quasi-Fermi level splitting." .

pv:TRPL a pv:CharacterisationTechnique ;
    rdfs:label "Time-Resolved Photoluminescence (TRPL)"@en ;
    skos:prefLabel "Time-Resolved Photoluminescence (TRPL)"@en ;
    dcterms:description "Measures minority carrier lifetime and non-radiative recombination dynamics via time-decay of photoluminescence signal." .

pv:XRD a pv:CharacterisationTechnique ;
    rdfs:label "X-Ray Diffraction (XRD)"@en ;
    skos:prefLabel "X-Ray Diffraction (XRD)"@en ;
    dcterms:description "Determines crystal structure, phase composition, lattice parameters, and crystallite size in PV absorber and transport layers." .

pv:SEM a pv:CharacterisationTechnique ;
    rdfs:label "Scanning Electron Microscopy (SEM)"@en ;
    skos:prefLabel "Scanning Electron Microscopy (SEM)"@en ;
    dcterms:description "High-resolution surface and cross-sectional imaging of thin-film morphology, grain size, and layer thickness." .

pv:TEM a pv:CharacterisationTechnique ;
    rdfs:label "Transmission Electron Microscopy (TEM)"@en ;
    skos:prefLabel "Transmission Electron Microscopy (TEM)"@en ;
    dcterms:description "Atomic-resolution imaging and diffraction of PV layer cross-sections revealing interface quality and defect structures." .

pv:DLTS a pv:CharacterisationTechnique ;
    rdfs:label "Deep Level Transient Spectroscopy (DLTS)"@en ;
    skos:prefLabel "Deep Level Transient Spectroscopy (DLTS)"@en ;
    dcterms:description "Identifies deep-level defect energy levels and capture cross-sections in semiconductors from capacitance transients vs temperature." .

pv:UVVis a pv:CharacterisationTechnique ;
    rdfs:label "UV-Vis Spectrophotometry"@en ;
    skos:prefLabel "UV-Vis Spectrophotometry"@en ;
    dcterms:description "Measures optical absorbance and transmittance to extract bandgap (via Tauc plot) and quantify optical losses." .

pv:EL a pv:CharacterisationTechnique ;
    rdfs:label "Electroluminescence (EL) Imaging"@en ;
    skos:prefLabel "Electroluminescence (EL) Imaging"@en ;
    dcterms:description "Forward-biased module or cell imaging to detect shunts, cracks, and inactive regions by near-IR photon emission." .

# ═══════════════════════════════════════════════════════════════════════════════
#  DEFECTS
# ═══════════════════════════════════════════════════════════════════════════════

pv:IodideVacancy a pv:Defect ;
    rdfs:label "Iodide Vacancy (V_I)"@en ;
    skos:prefLabel "Iodide Vacancy (V_I)"@en ;
    dcterms:description "Most abundant intrinsic point defect in halide perovskites; forms shallow or deep trap states and enables harmful ion migration." ;
    pv:affectsMetric pv:PCE, pv:Voc ;
    pv:mitigatedBy pv:ThermalAnnealing .

pv:GrainBoundaryTrap a pv:Defect ;
    rdfs:label "Grain Boundary Trap States"@en ;
    skos:prefLabel "Grain Boundary Trap States"@en ;
    dcterms:description "Non-radiative recombination centres concentrated at polycrystalline grain boundaries in perovskite and silicon thin films." ;
    pv:affectsMetric pv:PCE, pv:FF ;
    pv:mitigatedBy pv:ThermalAnnealing .

pv:PhaseSeparation a pv:Defect ;
    rdfs:label "Phase Instability (Delta-Phase)"@en ;
    skos:prefLabel "Phase Instability (Delta-Phase)"@en ;
    dcterms:description "Transformation of photoactive alpha-FAPbI3 to the inactive delta-phase under humidity or sub-zero temperatures; major stability concern." ;
    pv:affectsMetric pv:PCE .

pv:CuVacancy a pv:Defect ;
    rdfs:label "Copper Vacancy (V_Cu) in CIGS"@en ;
    skos:prefLabel "Copper Vacancy (V_Cu) in CIGS"@en ;
    dcterms:description "Dominant acceptor defect in CIGS absorber; controls p-type conductivity but excess vacancies accelerate recombination." ;
    pv:affectsMetric pv:Voc .

pv:CdVacancy a pv:Defect ;
    rdfs:label "Cadmium Vacancy (V_Cd) in CdTe"@en ;
    skos:prefLabel "Cadmium Vacancy (V_Cd) in CdTe"@en ;
    dcterms:description "Acceptor defect in CdTe; important for p-type doping but can pin the Fermi level and increase interface recombination." ;
    pv:affectsMetric pv:Voc, pv:FF .

pv:InterfaceRecombination a pv:Defect ;
    rdfs:label "Interface Recombination"@en ;
    skos:prefLabel "Interface Recombination"@en ;
    dcterms:description "Non-radiative recombination at heterojunction interfaces (e.g., absorber/ETL, absorber/HTL); primary Voc loss mechanism in thin-film cells." ;
    pv:affectsMetric pv:Voc, pv:PCE .

pv:LID a pv:Defect ;
    rdfs:label "Light-Induced Degradation (LID)"@en ;
    skos:prefLabel "Light-Induced Degradation (LID)"@en ;
    dcterms:description "Efficiency loss in boron-doped c-Si wafers upon initial illumination caused by formation of boron-oxygen complexes." ;
    pv:affectsMetric pv:PCE .

# ═══════════════════════════════════════════════════════════════════════════════
#  PERFORMANCE METRICS
# ═══════════════════════════════════════════════════════════════════════════════

pv:PCE a pv:PerformanceMetric ;
    rdfs:label "Power Conversion Efficiency (PCE)"@en ;
    skos:prefLabel "Power Conversion Efficiency (PCE)"@en ;
    dcterms:description "Ratio of maximum electrical power output to incident solar irradiance; primary figure of merit for comparing PV technologies." ;
    qudt:specializationOf quantitykind:DimensionlessRatio ;
    qudt:hasUnit unit:PERCENT ;
    pv:typicalRange "14-34 for champion research cells" ;
    pv:measuredBy pv:JVCurve .

pv:Voc a pv:PerformanceMetric ;
    rdfs:label "Open-Circuit Voltage (Voc)"@en ;
    skos:prefLabel "Open-Circuit Voltage (Voc)"@en ;
    dcterms:description "Maximum voltage at zero current; determined by quasi-Fermi level splitting and dominated by non-radiative recombination rate." ;
    qudt:specializationOf quantitykind:ElectricPotentialDifference ;
    qudt:hasUnit unit:V ;
    pv:typicalRange "0.65-1.20 depending on absorber material" ;
    pv:measuredBy pv:JVCurve .

pv:Jsc a pv:PerformanceMetric ;
    rdfs:label "Short-Circuit Current Density (Jsc)"@en ;
    skos:prefLabel "Short-Circuit Current Density (Jsc)"@en ;
    dcterms:description "Current density at zero applied voltage; proportional to absorbed photon flux and charge collection efficiency." ;
    qudt:specializationOf quantitykind:ElectricCurrentDensity ;
    qudt:hasUnit unit:A-PER-M2 ;
    pv:typicalRange "150-450" ;
    pv:measuredBy pv:JVCurve, pv:EQE .

pv:FF a pv:PerformanceMetric ;
    rdfs:label "Fill Factor (FF)"@en ;
    skos:prefLabel "Fill Factor (FF)"@en ;
    dcterms:description "Ratio of maximum power to the product of Voc and Jsc; reflects series resistance, shunt resistance, and recombination losses." ;
    qudt:specializationOf quantitykind:DimensionlessRatio ;
    qudt:hasUnit unit:FRACTION ;
    pv:typicalRange "0.70-0.88 for high-performance cells" ;
    pv:measuredBy pv:JVCurve .

pv:CarrierLifetime a pv:PerformanceMetric ;
    rdfs:label "Minority Carrier Lifetime"@en ;
    skos:prefLabel "Minority Carrier Lifetime"@en ;
    dcterms:description "Average time before photo-generated minority carriers recombine; high lifetime (milliseconds) required for high Voc and PCE." ;
    qudt:specializationOf quantitykind:Time ;
    qudt:hasUnit unit:MicroSEC ;
    qudt:applicableUnit unit:MilliSEC ;
    pv:measuredBy pv:TRPL .

pv:Hysteresis a pv:PerformanceMetric ;
    rdfs:label "J-V Hysteresis Index (HI)"@en ;
    skos:prefLabel "J-V Hysteresis Index (HI)"@en ;
    dcterms:description "Difference in measured PCE between forward and reverse J-V sweep directions in perovskite cells; caused by ion migration." ;
    qudt:specializationOf quantitykind:DimensionlessRatio ;
    qudt:hasUnit unit:UNITLESS ;
    pv:measuredBy pv:JVCurve .

# ═══════════════════════════════════════════════════════════════════════════════
#  DEGRADATION MECHANISMS
# ═══════════════════════════════════════════════════════════════════════════════

pv:MoistureIngress a pv:DegradationMechanism ;
    rdfs:label "Moisture Ingress"@en ;
    skos:prefLabel "Moisture Ingress"@en ;
    dcterms:description "Water vapour permeation into perovskite layers causes hydration and chemical decomposition of the perovskite structure into PbI2." ;
    pv:causedBy pv:GrainBoundaryTrap .

pv:ThermalDegradation a pv:DegradationMechanism ;
    rdfs:label "Thermal Degradation"@en ;
    skos:prefLabel "Thermal Degradation"@en ;
    dcterms:description "Above 85 °C, MAPbI3 decomposes releasing methylamine gas and forming yellow PbI2; accelerated by IEC 61215 damp heat test." ;
    pv:onsetTemperature "85"^^xsd:decimal ;
    pv:causedBy pv:PhaseSeparation .

pv:UVDegradation a pv:DegradationMechanism ;
    rdfs:label "UV-Induced Degradation"@en ;
    skos:prefLabel "UV-Induced Degradation"@en ;
    dcterms:description "UV photons generate reactive oxygen species in TiO2 ETL and degrade organic HTL (Spiro-OMeTAD), reducing Voc and FF." ;
    pv:causedBy pv:InterfaceRecombination .

pv:PID a pv:DegradationMechanism ;
    rdfs:label "Potential-Induced Degradation (PID)"@en ;
    skos:prefLabel "Potential-Induced Degradation (PID)"@en ;
    dcterms:description "High system voltage drives Na+ ion migration through encapsulant into silicon cells, increasing surface recombination velocity." ;
    pv:causedBy pv:LID .

pv:IonMigration a pv:DegradationMechanism ;
    rdfs:label "Ion Migration"@en ;
    skos:prefLabel "Ion Migration"@en ;
    dcterms:description "Mobile halide ions drift under electric field or thermal activation causing J-V hysteresis, interface degradation, and instability." ;
    pv:causedBy pv:IodideVacancy .

# ═══════════════════════════════════════════════════════════════════════════════
#  STANDARD TEST CONDITIONS
# ═══════════════════════════════════════════════════════════════════════════════

pv:STC a pv:StandardTest ;
    rdfs:label "Standard Test Conditions (STC)"@en ;
    skos:prefLabel "Standard Test Conditions (STC)"@en ;
    dcterms:description "AM1.5G spectrum, 1000 W/m² irradiance, and 25 °C cell temperature as defined in IEC 60904; reference condition for all PV efficiency records." ;
    pv:irradiance "1000"^^xsd:decimal ;
    pv:cellTemperature "25"^^xsd:decimal .

pv:NOCT a pv:StandardTest ;
    rdfs:label "Nominal Operating Cell Temperature (NOCT)"@en ;
    skos:prefLabel "Nominal Operating Cell Temperature (NOCT)"@en ;
    dcterms:description "800 W/m² irradiance, 20 °C ambient temperature, and 1 m/s wind speed; better represents real-world field operating conditions." ;
    pv:irradiance "800"^^xsd:decimal ;
    pv:ambientTemperature "20"^^xsd:decimal ;
    pv:windSpeed "1"^^xsd:decimal .

pv:DampHeat a pv:StandardTest ;
    rdfs:label "Damp Heat Test (IEC 61215)"@en ;
    skos:prefLabel "Damp Heat Test (IEC 61215)"@en ;
    dcterms:description "85 °C and 85% relative humidity for 1000 hours; assesses moisture resistance and encapsulant integrity of PV modules." ;
    pv:testTemperature "85"^^xsd:decimal ;
    pv:relativeHumidity "85"^^xsd:decimal ;
    pv:duration "1000"^^xsd:decimal .

pv:ThermalCycling a pv:StandardTest ;
    rdfs:label "Thermal Cycling Test (IEC 61215)"@en ;
    skos:prefLabel "Thermal Cycling Test (IEC 61215)"@en ;
    dcterms:description "200 cycles between -40 °C and +85 °C; tests mechanical integrity of solder bonds, cell interconnects, and encapsulant adhesion." ;
    pv:cycleCount "200"^^xsd:integer ;
    pv:minimumTemperature "-40"^^xsd:decimal ;
    pv:maximumTemperature "85"^^xsd:decimal .

