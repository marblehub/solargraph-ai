    rdfs:label "Whyte Goodfriend"@en ;
    skos:prefLabel "Whyte Goodfriend"@en ;
    prov:actedOnBehalfOf pv:Marblehub .

pv:Marblehub a prov:Organization ;
    rdfs:label "Marblehub"@en ;
    skos:prefLabel "Marblehub"@en .

